// Generated by CMake from benchmarks/support/experiments_main.cpp.in: registers every container's cells (each compiled from
// benchmarks/experiment.cpp) and runs them. Built twice from the same cells: benchmark_comparisons times them, with the
// heap as it is; benchmark_memory (URD_COUNT_HEAP) measures only their memory. It counts the heap: malloc and its kin
// are replaced (glibc allows it) by ones that keep the bytes asked for and still held, so a cell reads what its Store
// holds (urd::bench::live_bytes, benchmarks/support/lifecycle.hpp) whoever allocates it: operator new, a library, cista's malloc.
// Not under a sanitizer, which replaces malloc itself: there live_bytes is none and no memory is reported.

#include <algorithm>
#include <atomic>
#include <benchmark/benchmark.h>
#include <cstddef>
#include <cstring>
#include <exception>
#include <iostream>
#include <optional>

#if !defined(URD_COUNT_HEAP) || defined(__SANITIZE_ADDRESS__) || defined(__SANITIZE_THREAD__)
#define URD_COUNTS_HEAP 0
#elif defined(__has_feature)
#if __has_feature(address_sanitizer) || __has_feature(thread_sanitizer) || __has_feature(memory_sanitizer)
#define URD_COUNTS_HEAP 0
#endif
#endif
#if !defined(URD_COUNTS_HEAP) && defined(__GLIBC__)
#define URD_COUNTS_HEAP 1
#endif

#if URD_COUNTS_HEAP
namespace
{

std::atomic<std::size_t> live { 0 };

/// Each block carries, before what it gives, how far its start is (at least 16, the alignment asked for) and the
/// bytes asked for.
constexpr std::size_t header = 16;

void* counted(void* base, std::size_t offset, std::size_t size)
{
    if (base == nullptr)
        return nullptr;
    auto* given = static_cast<char*>(base) + offset;
    std::memcpy(given - 16, &offset, sizeof(offset));
    std::memcpy(given - 8, &size, sizeof(size));
    live.fetch_add(size, std::memory_order_relaxed);
    return given;
}
std::size_t size_of(void* given)
{
    std::size_t size = 0;
    std::memcpy(&size, static_cast<char*>(given) - 8, sizeof(size));
    return size;
}
void* base_of(void* given)
{
    std::size_t offset = 0;
    std::memcpy(&offset, static_cast<char*>(given) - 16, sizeof(offset));
    return static_cast<char*>(given) - offset;
}

}  // namespace

extern "C"
{
void* __libc_malloc(std::size_t size);
void __libc_free(void* block);
void* __libc_memalign(std::size_t alignment, std::size_t size);

void* malloc(std::size_t size) { return counted(__libc_malloc(size + header), header, size); }
void free(void* given)
{
    if (given == nullptr)
        return;
    live.fetch_sub(size_of(given), std::memory_order_relaxed);
    __libc_free(base_of(given));
}
void* calloc(std::size_t count, std::size_t size)
{
    auto* given = malloc(count * size);
    if (given != nullptr)
        std::memset(given, 0, count * size);
    return given;
}
void* realloc(void* given, std::size_t size)
{
    if (given == nullptr)
        return malloc(size);
    auto* moved = malloc(size);
    if (moved != nullptr)
    {
        std::memcpy(moved, given, std::min(size, size_of(given)));
        free(given);
    }
    return moved;
}
void* memalign(std::size_t alignment, std::size_t size)
{
    const auto offset = alignment > header ? alignment : header;
    return counted(__libc_memalign(alignment, size + offset), offset, size);
}
void* aligned_alloc(std::size_t alignment, std::size_t size) { return memalign(alignment, size); }
int posix_memalign(void** into, std::size_t alignment, std::size_t size)
{
    *into = memalign(alignment, size);
    return *into == nullptr ? 12 : 0;  // ENOMEM
}
void* valloc(std::size_t size) { return memalign(4096, size); }
void* pvalloc(std::size_t size) { return memalign(4096, (size + 4095) / 4096 * 4096); }
std::size_t malloc_usable_size(void* given) { return given == nullptr ? 0 : size_of(given); }
}
#endif

namespace urd::bench
{

/// The heap bytes asked for and still held; none where the heap is not counted.
std::optional<std::size_t> live_bytes()
{
#if URD_COUNTS_HEAP
    return live.load(std::memory_order_relaxed);
#else
    return std::nullopt;
#endif
}

}  // namespace urd::bench

@URD_EXPERIMENT_DECLARATIONS@
int main(int argc, char** argv)
try
{
@URD_EXPERIMENT_CALLS@
    benchmark::Initialize(&argc, argv);
    benchmark::RunSpecifiedBenchmarks();
    benchmark::Shutdown();
    return 0;
}
catch (const std::exception& error)
{
    std::cerr << "benchmark_comparisons: " << error.what() << "\n";
    return 1;
}
